{
  "openapi": "3.0.1",
  "info": {
    "title": "BackEnd",
    "version": "1.0"
  },
  "paths": {
    "/api/artistas": {
      "get": {
        "tags": [
          "Artist"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/users/register": {
      "post": {
        "tags": [
          "User"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/dtUsuarios"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/dtUsuarios"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/dtUsuarios"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/users/login": {
      "post": {
        "tags": [
          "User"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/votos/registrarVoto": {
      "post": {
        "tags": [
          "Vote"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VotoRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/VotoRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/VotoRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/votos": {
      "get": {
        "tags": [
          "Vote"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/votos/usuario/{idUsuario}": {
      "get": {
        "tags": [
          "Vote"
        ],
        "parameters": [
          {
            "name": "idUsuario",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/votos/eliminar/{id}": {
      "delete": {
        "tags": [
          "Vote"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/votos/resultados": {
      "get": {
        "tags": [
          "Vote"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "VotoRequest": {
        "type": "object",
        "properties": {
          "idArtista": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "dtUsuarios": {
        "required": [
          "contrasenia",
          "correo"
        ],
        "type": "object",
        "properties": {
          "idUsuario": {
            "type": "integer",
            "format": "int32"
          },
          "nombre": {
            "type": "string",
            "nullable": true
          },
          "apellidos": {
            "type": "string",
            "nullable": true
          },
          "correo": {
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "contrasenia": {
            "type": "string",
            "nullable": true
          },
          "eliminado": {
            "type": "boolean"
          },
          "idRolUsuario": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "idRolUsuarioNavigation": {
            "$ref": "#/components/schemas/msRolesUsuario"
          }
        },
        "additionalProperties": false
      },
      "msRolesUsuario": {
        "required": [
          "descripcionRol"
        ],
        "type": "object",
        "properties": {
          "idRolUsuario": {
            "type": "integer",
            "format": "int32"
          },
          "descripcionRol": {
            "type": "string",
            "nullable": true
          },
          "eliminado": {
            "type": "boolean"
          },
          "usuarios": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/dtUsuarios"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}